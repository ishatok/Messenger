              <property name="styleSheet">
               <string notr="true">/* Основной стиль чата */
QTextBrowser {
    background-color: #1a1a1a;
    border: none;
    border-radius: 10px;
    padding: 10px;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 14px;
    color: white;
}

/* Свои сообщения (справа) */
.message-own {
    margin: 10px 0px;
    text-align: right;
}

.message-content-own {
    display: inline-block;
    max-width: 70%;
    background-color: #805AD5;
    color: white;
    padding: 12px 16px;
    border-radius: 18px;
    border-bottom-right-radius: 4px;
    word-wrap: break-word;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
}

.message-text-own {
    font-size: 14px;
    line-height: 1.4;
    margin-bottom: 4px;
}

.message-time-own {
    font-size: 11px;
    opacity: 0.8;
    text-align: right;
}

/* Чужие сообщения (слева) */
.message-other {
    margin: 10px 0px;
    text-align: left;
}

.message-sender-other {
    font-size: 12px;
    color: #A0AEC0;
    margin-bottom: 4px;
    margin-left: 8px;
    font-weight: 500;
}

.message-content-other {
    display: inline-block;
    max-width: 70%;
    background-color: #2D3748;
    color: white;
    padding: 12px 16px;
    border-radius: 18px;
    border-bottom-left-radius: 4px;
    word-wrap: break-word;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.message-text-other {
    font-size: 14px;
    line-height: 1.4;
    margin-bottom: 4px;
}

.message-time-other {
    font-size: 11px;
    opacity: 0.7;
    text-align: right;
}</string>
              </property>
