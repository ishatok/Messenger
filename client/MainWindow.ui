  <property name="styleSheet">
   <string notr="true">/* Главное окно */
                QMainWindow {
                background-color: #1A202C;
                color: #F7FAFC;
                font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
                }

                /* Stacked Widget */
                QStackedWidget {
                background: transparent;
                border: none;
                }

                QStackedWidget::item {
                background: transparent;
                }

                /* Кнопки */
                QPushButton {
                background-color: #805AD5;
                color: white;
                border: none;
                border-radius: 8px;
                padding: 12px 24px;
                font-size: 14px;
                font-weight: bold;
                min-height: 20px;
                }

                QPushButton:hover {
                background-color: #6B46C1;
                }

                QPushButton:pressed {
                background-color: #553C9A;
                }

                QPushButton:disabled {
                background-color: #4A5568;
                color: #A0AEC0;
                }

                /* Поля ввода */
                QLineEdit {
                background-color: #2D3748;
                border: 2px solid #4A5568;
                border-radius: 8px;
                padding: 12px 16px;
                font-size: 14px;
                color: #F7FAFC;
                }

                QLineEdit:focus {
                border-color: #805AD5;
                }

                QLineEdit[echoMode=&quot;2&quot;] {
                font-family: &quot;Courier New&quot;, monospace;
                letter-spacing: 1px;
                }

                /* Метки */
                QLabel {
                background: transparent;
                color: #F7FAFC;
                font-size: 14px;
                border: none;
                }

                /* Списки */
                QListWidget {
                background-color: #2D3748;
                border: 2px solid #4A5568;
                border-radius: 8px;
                padding: 4px;
                font-size: 14px;
                color: #F7FAFC;
                outline: none;
                }

                QListWidget::item {
                background-color: transparent;
                border: none;
                padding: 12px 16px;
                margin: 2px;
                border-radius: 6px;
                }

                QListWidget::item:selected {
                background-color: #805AD5;
                color: white;
                }

                QListWidget::item:hover {
                background-color: #4A5568;
                }

                /* Текстовые области */
                QTextEdit, QTextBrowser {
                background-color: #2D3748;
                border: 2px solid #4A5568;
                border-radius: 8px;
                padding: 12px;
                font-size: 14px;
                color: #F7FAFC;
                }

                /* Сплиттер */
                QSplitter::handle {
                background-color: #4A5568;
                border: 1px solid #2D3748;
                }

                QSplitter::handle:horizontal {
                width: 2px;
                }

                QSplitter::handle:vertical {
                height: 2px;
                }

/* === СТИЛИ УВЕДОМЛЕНИЯ === */

/* Базовый стиль уведомления */
QFrame#login_notification {
    border-radius: 8px;
    padding: 8px 12px;
    background-color: #F56565;
    border: 2px solid #E53E3E;
}

/* Стили для разных типов уведомлений */
QFrame#login_notification[notificationType=&quot;success&quot;] {
    background-color: #48BB78;
    border: 2px solid #38A169;
}

QFrame#login_notification[notificationType=&quot;warning&quot;] {
    background-color: #ED8936;
    border: 2px solid #DD6B20;
}

QFrame#login_notification[notificationType=&quot;info&quot;] {
    background-color: #4299E1;
    border: 2px solid #3182CE;
}

QFrame#login_notification[notificationType=&quot;error&quot;] {
    background-color: #F56565;
    border: 2px solid #E53E3E;
}

/* Метка уведомления - КРИТИЧЕСКИ ВАЖНЫЕ СТИЛИ */
QLabel#login_notify_label {
    color: white;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
    border: none;
    margin: 0px;
    padding: 0px;
}

/* Обязательно добавь эти свойства для метки в Qt Designer */
QLabel#login_notify_label {
    min-height: 20px;
    qproperty-alignment: 'AlignVCenter | AlignLeft';
}

/* Кнопка закрытия */
QPushButton#login_notify_close {
    background: transparent;
    border: none;
    color: white;
    font-size: 16px;
    font-weight: bold;
    min-width: 24px;
    min-height: 24px;
    max-width: 24px;
    max-height: 24px;
}

QPushButton#login_notify_close:hover {
    background: rgba(255,255,255,0.3);
    border-radius: 12px;
}


/* Глобальное уведомление */
QFrame#global_notification {
    background-color: #F56565;
    border: 2px solid #E53E3E;
    border-radius: 8px;
}

QFrame#global_notification[notificationType=&quot;success&quot;] {
    background-color: #48BB78;
    border: 2px solid #38A169;
}

QFrame#global_notification[notificationType=&quot;warning&quot;] {
    background-color: #ED8936;
    border: 2px solid #DD6B20;
}

QFrame#global_notification[notificationType=&quot;info&quot;] {
    background-color: #4299E1;
    border: 2px solid #3182CE;
}

QFrame#global_notification[notificationType=&quot;error&quot;] {
    background-color: #F56565;
    border: 2px solid #E53E3E;
}

/* Текст уведомления */
QLabel#global_notify_label {
    color: white;
    font-size: 14px;
    font-weight: bold;
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}

/* Кнопка закрытия */
QPushButton#global_notify_close {
    background: transparent;
    border: none;
    color: white;
    font-size: 18px;
    font-weight: bold;
    border-radius: 15px;
}

QPushButton#global_notify_close:hover {
    background: rgba(255,255,255,0.3);
}

QTextBrowser {
    background-color: #1a1a1a;
    border: none;
    border-radius: 10px;
    padding: 10px;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 14px;
}</string>
